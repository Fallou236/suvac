# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(64))"
# Minimum 32 octets — en dessous, la signature JWT est vulnérable (RFC 7518 §3.2).
DJANGO_SECRET_KEY=a-generer-ne-jamais-reutiliser-entre-environnements
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=suvac
POSTGRES_USER=suvac
POSTGRES_PASSWORD=suvac
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REDIS_URL=redis://localhost:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:5173